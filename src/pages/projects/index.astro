---
import { getVisibleProjects } from '../../utils/projects';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';

// Same filter as /projects/[slug]: protected projects are not published here.
const projects = (await getVisibleProjects('project'))
  .filter(p => p.data.visibility !== 'private' && !p.data.password);
---
<Base title="Projects" description="Personal builds: courses, kits, tools and experiments.">
  <Nav />
  <main>
    <section class="header">
      <p class="overline">Projects</p>
      <h1>Things I'm building</h1>
      <p class="lead">Courses, kits and tools I make on my own time, mostly about using AI and data well.</p>
    </section>

    <div class="divider-wrap"><div class="divider"></div></div>

    <section class="list">
      {projects.length === 0 ? (
        <p class="empty">No projects yet — check back soon.</p>
      ) : (
        <div class="grid">
          {projects.map(p => (
            <ProjectCard
              slug={p.slug}
              href={`${import.meta.env.BASE_URL}projects/${p.slug}`}
              title={p.data.title}
              subtitle={p.data.subtitle}
              tags={p.data.tags}
              status={p.data.status}
              thumb={p.data.thumb}
              thumbBg={p.data.thumbBg}
              thumbText={p.data.thumbText}
              thumbTextColor={p.data.thumbTextColor}
              metrics={p.data.metrics}
              cta={p.data.cta}
              thumbFit={p.data.thumbFit}
            />
          ))}
        </div>
      )}
    </section>
  </main>
  <Footer />
</Base>

<style>
  main { padding-top: 64px; }

  .header {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 40px 48px;
  }
  .header h1 {
    font-family: var(--font-display);
    font-size: clamp(36px, 4vw, 56px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--fg);
    margin-top: 16px;
  }
  .lead {
    font-size: 18px;
    line-height: 1.6;
    color: var(--fg-muted);
    max-width: 640px;
    margin-top: 16px;
  }

  .divider-wrap { max-width: 1200px; margin: 0 auto; padding: 0 40px; }
  .divider { height: 1px; background: var(--border); }

  .list {
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 40px 96px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }
  .empty {
    font-size: 16px;
    color: var(--fg-muted);
  }

  @media (max-width: 640px) {
    .header { padding: 56px 20px 32px; }
    .divider-wrap { padding: 0 20px; }
    .list { padding: 40px 20px 64px; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
